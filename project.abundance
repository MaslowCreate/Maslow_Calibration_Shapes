              "name": "toMove",
              "type": "geometry",
              "options": []
            },
            {
              "atomType": "Code",
              "x": 0.3268,
              "y": 0.4286,
              "uniqueID": "id-330",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                }
              ],
              "interpreterVersion": 1,
              "code": "function run(shape: Assembly) {\n  let left = Number.POSITIVE_INFINITY\n  let south = Number.POSITIVE_INFINITY\n  let under = Number.POSITIVE_INFINITY\n  shape.onLeafs((leaf) => {\n    const bounds = leaf.geometry.boundingBox.bounds;\n    left = Math.min(left, bounds[0][0])\n    south = Math.min(south, bounds[0][1])\n    const zbound = bounds[0][2];\n    under = zbound != undefined ? Math.min(under, zbound) : under\n    return leaf;\n  })\n  console.log(`left: ${left}, south: ${south}, under ${under}`)\n  under = under == Number.POSITIVE_INFINITY ? 0 : under;\n  return shape.onLeafs((leaf) => {\n    leaf.geometry = leaf.geometry.translate(-1 * left, -1 * south, -1 * under)\n    return leaf;\n  })\n}",
              "compiledCode": "\"use strict\";\nfunction run(shape) {\n    let left = Number.POSITIVE_INFINITY;\n    let south = Number.POSITIVE_INFINITY;\n    let under = Number.POSITIVE_INFINITY;\n    shape.onLeafs((leaf) => {\n        const bounds = leaf.geometry.boundingBox.bounds;\n        left = Math.min(left, bounds[0][0]);\n        south = Math.min(south, bounds[0][1]);\n        const zbound = bounds[0][2];\n        under = zbound != undefined ? Math.min(under, zbound) : under;\n        return leaf;\n    });\n    console.log(`left: ${left}, south: ${south}, under ${under}`);\n    under = under == Number.POSITIVE_INFINITY ? 0 : under;\n    return shape.onLeafs((leaf) => {\n        leaf.geometry = leaf.geometry.translate(-1 * left, -1 * south, -1 * under);\n        return leaf;\n    });\n}\n"
            }
          ],
